{
  "name": "seogi",
  "productName": "Seogi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/provider": "^4.0.38",
    "@cartanova/qgrid-ai-sdk": "2.22.2",
    "ai": "7.0.173",
    "lucide-react": "^1.73.0",
    "pretendard": "^1.3.9",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc",
    "test": "node --test src/",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "io.github.dongseonyoo.seogi",
    "productName": "Seogi",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의에서 내 목소리를 받아 적으려면 마이크가 필요합니다.",
        "NSAudioCaptureUsageDescription": "상대방 목소리를 받아 적으려면 시스템 오디오가 필요합니다.",
        "LSHasLocalizedDisplayName": true
      },
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build/ko.lproj",
          "to": "ko.lproj"
        },
        {
          "from": "build/en.lproj",
          "to": "en.lproj"
        }
      ]
    }
  }
}
